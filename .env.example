# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (PostgreSQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=job_scheduler

# ---- Worker ----
# How often (ms) a worker polls for the next due job
WORKER_POLL_INTERVAL_MS=1000
# Number of jobs a single worker claims per tick
WORKER_BATCH_SIZE=1

# ---- Retry / Backoff ----
MAX_RETRIES=3
# Base backoff seconds; delay = BACKOFF_BASE_SECONDS * (BACKOFF_FACTOR ^ (attempt-1))
BACKOFF_BASE_SECONDS=1
BACKOFF_FACTOR=5
# Jitter as a fraction of the computed delay (0.2 = +/-20%)
BACKOFF_JITTER=0.2

# ---- Dead-Letter Queue ----
# When the number of unresolved DLQ jobs reaches this, an email alert fires.
DLQ_ALERT_THRESHOLD=5
ALERT_EMAIL_TO=ops@dilamme.test

# ---- Starvation prevention (aging) ----
# Every AGING_BUMP_SECONDS a waiting job's effective priority improves by 1 level.
AGING_BUMP_SECONDS=30

# ---- Email handler simulation ----
# Probability (0..1) that the mocked email send fails, to exercise retries/DLQ.
EMAIL_FAILURE_RATE=0.0
